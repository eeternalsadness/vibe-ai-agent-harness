{
  "name": "vibe-ai-agent-harness",
  "private": true,
  "scripts": {
    "test": "bun test && uv run --with pyyaml test/integration/test_pipeline_runner.py -v",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "bun run lint:biome && bun run lint:ruff && bun run lint:shell",
    "lint:biome": "biome lint .",
    "lint:ruff": "ruff check .",
    "lint:shell": "find . -name '*.sh' -not -path './dist/*' -not -path './node_modules/*' -not -path './test/fixtures/*' -not -path './.agents/worktrees/*' -print0 | xargs -0 shellcheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@opencode/plugin": "2.0.32",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
